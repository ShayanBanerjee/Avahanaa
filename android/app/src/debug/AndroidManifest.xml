<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Debug-build overlay only. This file is NOT merged into release builds, so
      the shipped app keeps Android's default "no cleartext HTTP" policy.

      It exists so a debug build can reach the local Firebase Auth and Firestore
      emulators, which serve plain HTTP on the host machine (10.0.2.2 from
      inside the Android emulator). See lib/firebase_emulators.dart.
    -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
